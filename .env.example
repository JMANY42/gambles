# Copy to .env and edit. Every setting is optional.

# --- Kalshi API key (OPTIONAL) ---
# Market data is public, so the app works without a key. A key only raises
# your rate limit. This app is read-only and never places real orders.
# Create one at https://kalshi.com/account/profile -> API Keys.
# KALSHI_API_KEY_ID=your-key-id-uuid
# KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi-private-key.pem

# --- Server ---
# GAMBLES_HOST=127.0.0.1
# GAMBLES_PORT=8000
# GAMBLES_DB=./data/gambles.db

# --- Simulation ---
# GAMBLES_STARTING_BALANCE=25000     # default bankroll for scenario portfolios
# GAMBLES_SCENARIO_STAKE=100         # $ per race for the All-Dem / All-GOP scenarios
# GAMBLES_SIMULATE_FEES=1            # apply Kalshi's taker fee formula (0 to disable)

# --- Refresh cadence ---
# GAMBLES_PRICE_REFRESH=60           # seconds between price refresh / settlement checks
# GAMBLES_CATALOG_REFRESH_HOURS=6    # how often to re-scan Kalshi for midterm markets
# GAMBLES_SNAPSHOT_MINUTES=5         # equity-chart sampling interval
# KALSHI_MAX_RPS=8                   # client-side request throttle
